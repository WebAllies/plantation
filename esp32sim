      reason.indexOf("already exists") >= 0 ||
      reason.indexOf("409") >= 0) {
    Serial.println("[Firestore] ensureDeviceDocument: existing document found");
    return true;
  }

  printFirestoreResult("ensureDeviceDocument create", false);
  return false;
}

void simulateSensors() {
  const float t = millis() / 1000.0f;

  temperatureC += randomDelta(0.20f) + 0.03f * sinf(t / 30.0f);
  ph += randomDelta(0.05f) + 0.01f * sinf(t / 45.0f);

  float waterDrift = randomDelta(0.50f) - 0.02f;
  if (pumpState) waterDrift -= 0.08f;
  if (valveState) waterDrift += 0.10f;
  waterLevelPct += waterDrift;

  float tdsDrift = randomDelta(5.0f);
  if (pumpState) tdsDrift += 1.5f;
  if (valveState) tdsDrift -= 1.2f;
  tdsPpm += tdsDrift;

  temperatureC = clampFloat(temperatureC, 20.0f, 32.0f);
  ph = clampFloat(ph, 6.0f, 8.0f);
  waterLevelPct = clampFloat(waterLevelPct, 30.0f, 100.0f);
  tdsPpm = clampFloat(tdsPpm, 600.0f, 1400.0f);
}

